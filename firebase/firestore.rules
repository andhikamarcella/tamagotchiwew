rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function roomDoc(roomId) {
      return get(roomPath(roomId)).data;
    }

    function roomDocAfter(roomId) {
      return getAfter(roomPath(roomId)).data;
    }

    function isRoomOwner(roomId) {
      return signedIn() && roomDoc(roomId).ownerUid == request.auth.uid;
    }

    function isRoomGuest(roomId) {
      return signedIn() && roomDoc(roomId).guestUid == request.auth.uid;
    }

    function isRoomMember(roomId) {
      return isRoomOwner(roomId) || isRoomGuest(roomId);
    }

    function isRoomOwnerAfter(roomId) {
      return signedIn() && roomDocAfter(roomId).ownerUid == request.auth.uid;
    }

    function isJoiningOpenRoom() {
      return signedIn()
        && resource.data.guestUid == null
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.status == 'active';
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function partnerCoinCredit(uid) {
      return signedIn()
        && request.resource.data.lastCoinTransferRoomId is string
        && request.resource.data.lastCoinTransferActionId is string
        && changedOnly(['coins', 'updatedAt', 'lastCoinTransferRoomId', 'lastCoinTransferActionId'])
        && request.resource.data.coins is number
        && resource.data.coins is number
        && request.resource.data.coins >= resource.data.coins
        && request.auth.uid != uid
        && isRoomMember(request.resource.data.lastCoinTransferRoomId)
        && (
          roomDoc(request.resource.data.lastCoinTransferRoomId).ownerUid == uid ||
          roomDoc(request.resource.data.lastCoinTransferRoomId).guestUid == uid
        );
    }

    function partnerCoinCreditCreate(uid) {
      return signedIn()
        && request.resource.data.keys().hasOnly(['coins', 'updatedAt', 'lastCoinTransferRoomId', 'lastCoinTransferActionId'])
        && request.resource.data.lastCoinTransferRoomId is string
        && request.resource.data.lastCoinTransferActionId is string
        && request.resource.data.coins is number
        && request.resource.data.coins >= 0
        && request.auth.uid != uid
        && isRoomMember(request.resource.data.lastCoinTransferRoomId)
        && (
          roomDoc(request.resource.data.lastCoinTransferRoomId).ownerUid == uid ||
          roomDoc(request.resource.data.lastCoinTransferRoomId).guestUid == uid
        );
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) || partnerCoinCreditCreate(uid);
      allow update: if isOwner(uid) || partnerCoinCredit(uid);
      allow delete: if isOwner(uid);

      match /pets/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /inventory/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /achievements/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /activityLogs/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /dailyGoals/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /weeklyQuests/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /notifications/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /notificationTokens/{docId} { allow read, create, update: if isOwner(uid); allow delete: if false; }
      match /collection/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /mailbox/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /roomDecor/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /petRequests/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /miniGameResults/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /badges/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /album/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /petMemorials/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /settings/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /saveState/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /offlineSync/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /singlePlayerState/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /usedCheatCodes/{docId} { allow read, create, update: if isOwner(uid); allow delete: if false; }
      match /dailyLimits/{docId} { allow read, create, update: if isOwner(uid); allow delete: if false; }
      match /keepsakes/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /careCalendar/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /moodTimeline/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /skillTree/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /training/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /clinicVisits/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /illnessHistory/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /reviveHistory/{docId} { allow read, create, update: if isOwner(uid); allow delete: if false; }
      match /petJournal/{docId} { allow read, create, update, delete: if isOwner(uid); }
      match /safetyItems/{docId} { allow read, create, update: if isOwner(uid); allow delete: if false; }
      match /pushCooldowns/{docId} { allow read: if isOwner(uid); allow create, update, delete: if false; }
      match /friends/{friendUid} { allow read, create, update, delete: if isOwner(uid); }
      match /friendRequests/{requestId} { allow read, create, update, delete: if isOwner(uid); }
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6
        && request.resource.data.status == 'waiting';
      allow read: if signedIn();
      allow update: if isRoomMember(roomId) || isJoiningOpenRoom();
      allow delete: if isRoomOwner(roomId);

      match /sharedPets/{petId} {
        allow create: if isRoomMember(roomId) || isRoomOwnerAfter(roomId);
        allow read, update, delete: if isRoomMember(roomId);
      }

      match /events/{eventId} {
        allow create: if signedIn()
          && request.resource.data.actorUid == request.auth.uid
          && (isRoomMember(roomId) || isRoomOwnerAfter(roomId));
        allow read: if signedIn();
        allow update, delete: if false;
      }

      match /presence/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && uid == request.auth.uid;
      }

      match /coupleQuests/{questId} {
        allow read, create, update, delete: if isRoomMember(roomId);
      }

      match /sharedInventory/{itemId} {
        allow read, create, update, delete: if isRoomMember(roomId);
      }

      match /coupleAlbum/{memoryId} {
        allow read, create, update, delete: if isRoomMember(roomId);
      }

      match /messages/{messageId} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId) && request.resource.data.senderUid == request.auth.uid;
        allow update: if isRoomMember(roomId) && (resource.data.senderUid == request.auth.uid || isRoomOwner(roomId));
        allow delete: if false;

        match /reactions/{uid} {
          allow read: if isRoomMember(roomId);
          allow write: if isRoomMember(roomId) && uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
        }
      }

      match /coinTransfers/{transferId} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId) && request.resource.data.fromUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /globalConfig/{docId} { allow read: if true; allow write: if false; }
    match /_debug/{docId} { allow read, write: if false; }
  }
}
